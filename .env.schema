# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @plugin(@varlock/infisical-plugin@1.1.0)
# @initInfisical(
#   projectId=$INFISICAL_PROJECT_ID,
#   environment=$INFISICAL_ENVIRONMENT,
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET,
#   siteUrl=https://eu.infisical.com
# )
# @defaultRequired=infer @defaultSensitive=false
# ----------

# @required @type=string
INFISICAL_PROJECT_ID=

# @required @type=string
INFISICAL_ENVIRONMENT=

# @required @type=infisicalClientId
INFISICAL_CLIENT_ID=

# @required @type=infisicalClientSecret @sensitive
INFISICAL_CLIENT_SECRET=

# @type=string
ACCOUNTAV_PUBLISHABLE_KEY=infisical()

# @type=string @sensitive
ACCOUNTAV_SECRET_KEY=infisical("CLERK_SECRET_KEY")

# @type=url
ACCOUNTAV_API_BASE_URL=infisical()

# @type=url
ANIMATEAV_API_BASE_URL=infisical()

# @type=url
ANIMATEAV_CONVEX_URL=infisical()

# @type=url
ANIMATEAV_TERMS_URL=infisical()

# @type=url
ANIMATEAV_PRIVACY_URL=infisical()

# @type=url
ACCOUNTAV_MANAGEMENT_URL=infisical()

# @type=url
SUPPORTAV_BASE_URL=infisical()

# @type=email
ANIMATEAV_SUPPORT_EMAIL=infisical()

# @type=url
ANIMATEAV_OPEN_SOURCE_URL=https://github.com/miguelavalos/animate-av
